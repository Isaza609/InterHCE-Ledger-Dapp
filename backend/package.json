{
  "name": "interhce-backend",
  "version": "0.1.0",
  "description": "Backend off-chain para InterHCE Ledger: validación de episodios clínicos, API para la DApp y orquestación con HAPI FHIR y Smart Contracts.",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "seed:eval-demo": "ts-node --transpile-only scripts/seed-evaluacion-demo.ts",
    "reset:demo-data": "ts-node --transpile-only scripts/reset-demo-data.ts",
    "test": "npm run build && node --test test/*.test.js"
  },
  "keywords": [
    "hce",
    "blockchain",
    "ethereum",
    "fhir",
    "urgencias",
    "interoperabilidad"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "dotenv": "^16.4.5",
    "body-parser": "^1.20.3",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.1",
    "@types/swagger-ui-express": "^4.1.8",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.2"
  }
}
