# Base URL del servidor HAPI FHIR (único almacenamiento off-chain).
# Si está definida, los episodios se persisten en HAPI FHIR; si no, en memoria.
# Ejemplo con HAPI en Docker Compose (desde el host):
FHIR_BASE_URL=http://localhost:8080/fhir

# Si el backend corre dentro de Docker en el mismo docker-compose, usar el nombre del servicio:
# FHIR_BASE_URL=http://hapi-fhir:8080/fhir

# Puerto del backend (opcional, por defecto 3001)
# PORT=3001
